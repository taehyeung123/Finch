{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/flush-views", "schedule": "* * * * *" },

    { "path": "/api/cron/refresh-tokens", "schedule": "0 18 * * *" },
    { "path": "/api/cron/flush-dms", "schedule": "10 23 * * *" },
    { "path": "/api/cron/publish-scheduled", "schedule": "*/5 * * * *" },

    { "path": "/api/cron/pool-plan", "schedule": "0 20 * * *" },

    { "path": "/api/cron/pool-work", "schedule": "30 20 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 23 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 2 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 5 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 8 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 11 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 14 * * *" },
    { "path": "/api/cron/pool-work", "schedule": "30 17 * * *" },

    { "path": "/api/cron/pool-finalize", "schedule": "30 18 * * *" },

    { "path": "/api/cron/retention", "schedule": "20 19 * * *" },

    { "path": "/api/cron/storage-sweep", "schedule": "40 20 * * *" }
  ]
}
