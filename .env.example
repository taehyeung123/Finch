# Supabase — 발급 위치: https://supabase.com/dashboard > 프로젝트 선택 > Project Settings > API
# 두 값 모두 없으면 앱은 데모 모드로 동작한다 (설정 절차: docs/AUTH_SETUP.md)
# anon key는 공개 가능 키. SUPABASE_SERVICE_ROLE_KEY는 이번 기능에 불필요하며 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 데모 모드 강제 스위치 — true로 두면 위 Supabase 키가 있어도 로그인을 건너뛰고
# 전체 화면을 열어준다. Supabase 프로젝트가 일시정지/한도초과로 로그인이 막혔을 때
# 이 한 줄로 사이트를 즉시 다시 열 수 있다. 정식 운영 시에는 비워두거나 false.
NEXT_PUBLIC_DEMO_MODE=

# 검색엔진 사이트 소유 확인 — 네이버 서치어드바이저/구글 서치콘솔에서 HTML 태그 방식 선택 후
# content="..." 값만 여기 넣으면 루트 레이아웃이 메타태그를 자동 출력한다 (미설정 시 태그 미출력).
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Claude API — AI 스튜디오(카드뉴스·아이디어 생성). 서버 전용, NEXT_PUBLIC_ 금지.
# 발급: https://console.anthropic.com > API Keys. 비어 있으면 템플릿 생성으로 폴백.
ANTHROPIC_API_KEY=

# ── 인스타 댓글 자동 DM (전부 서버 전용 — 절대 NEXT_PUBLIC_ 금지) ──────────────
# 설정 절차: docs/AUTO_DM_SETUP.md / 비용·리스크: docs/AUTO_DM_COST_RISK.md
# 비어 있으면 웹훅 라우트(app/api/webhooks/instagram)는 503으로 응답하고 아무것도 처리하지 않는다.

# Meta 앱 대시보드 > Webhooks 구독 등록 시 입력하는 임의의 긴 문자열 (내가 정해서 양쪽에 넣는 값)
IG_WEBHOOK_VERIFY_TOKEN=
# Meta 앱 대시보드 > 설정 > 기본 설정 > 앱 시크릿 코드
META_APP_SECRET=
# Supabase 대시보드 > Project Settings > API > service_role 키 (RLS 우회 — 웹훅 전용)
SUPABASE_SERVICE_ROLE_KEY=
# (선택, 개발자 모드 테스트 전용) OAuth 연동 전 본인 계정으로 발송 테스트할 때 쓰는 임시 토큰.
# 운영에서는 비워두고 connected_accounts의 암호화 토큰을 사용한다.
IG_TEST_ACCESS_TOKEN=

# ── 채널 토큰 암호화 (연동 시 필수 — 서버 전용) ────────────────────────────
# 저장 토큰은 AES-256-GCM으로 앱단 암호화한다(lib/crypto/tokens). 32바이트 키를 base64/hex로.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 미설정이면 인스타 연동 콜백이 평문 저장 대신 중단된다(CLAUDE.md 보안 규칙).
TOKEN_ENCRYPTION_KEY=

# ── Instagram Login OAuth (연동 시 필수 — 서버 전용) ───────────────────────
# Meta 앱 대시보드 > 제품 Instagram > "Instagram 앱 ID".
# 실 스펙·절차: docs/REAL_API_SPEC.md 1절 / 콜백 URL은 /api/auth/instagram/callback.
#
# ⚠️ 시크릿은 **Instagram 제품의 것**이다 — 「설정 > 기본 설정 > 앱 시크릿 코드」(META_APP_SECRET)와
#    다른 값이다. Instagram Login 은 제품 단위로 ID·시크릿 한 쌍을 발급하고 토큰 교환이 그 쌍을 요구한다.
#    2026-08-06 에 이 둘을 «통일» 한다며 합쳤다가 토큰 교환이 6주간 조용히 깨져 있었다(2026-08-31 적발).
#    미설정이면 META_APP_SECRET 으로 폴백하지만, 값이 다르면 연동이 실패한다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Threads OAuth (연동 시 필수 — 서버 전용) ────────────────────────────
# Meta 앱 대시보드 > 제품 Threads > "Threads 앱 ID / 앱 시크릿".
# 사업자등록·앱심사 없이 개발자 모드에서 앱 역할(테스터)로 등록한 본인 계정으로 바로 연동 가능(Standard Access).
# 실 스펙·절차: docs/REAL_API_SPEC.md 5절 / 콜백 URL은 /api/auth/threads/callback.
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── TikTok Login Kit OAuth (연동 시 필수 — 서버 전용) ───────────────────
# developers.tiktok.com > Manage apps > 앱 생성 후 App details 상단의 "Client Key / Client Secret".
# 사업자등록·앱심사 없이 Sandbox + 테스터 계정(target user, 최대 10개) 등록으로 바로 연동 가능.
# 심사 없이 확인된 범위는 기본 프로필(팔로워·좋아요·영상 수)뿐 — 영상 목록·인사이트는 미구현(TODO).
# 실 스펙·절차: docs/REAL_API_SPEC.md 6절 / 콜백 URL은 /api/auth/tiktok/callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Meta 광고 (Marketing API, Facebook Login) — 서버 전용 ─────────────────
# Meta 앱 대시보드 > 설정 > 기본 설정의 「앱 ID」. 시크릿은 바로 위 META_APP_SECRET 을 그대로 쓴다.
#
# ⚠️ 인스타·스레드와 **다른 네 번째 연동**이다. 기존 토큰으로는 광고를 못 부른다:
#    호스트가 graph.facebook.com(인스타는 graph.instagram.com), 자격증명이 Facebook 앱 것,
#    스코프가 ads_read(인스타 스코프엔 광고 권한이 없다).
# ⚠️⚠️ 이 연동의 장기 토큰은 **자동 갱신이 안 된다.** 약 60일마다 사용자가 다시 연결해야 한다
#    (인스타/스레드/틱톡은 전부 갱신된다 — 광고만 예외다). 화면이 만료일을 표시한다.
#
# 메타 앱에 「광고 관리(Facebook Login) 이용 사례」를 추가하고 아래 URL 을 등록해야 한다:
#   유효한 OAuth 리디렉션 URI : https://finch.ai.kr/api/auth/meta-ads/callback
#   연동 해제 콜백 URL        : https://finch.ai.kr/api/auth/meta-ads/deauthorize
#   데이터 삭제 요청 URL      : https://finch.ai.kr/api/auth/meta-ads/data-deletion
# 미설정이면 설정 화면의 광고 카드가 «연동 준비중» 으로만 보이고 버튼이 안 켜진다.
META_APP_ID=

# ── 광고를 «다른 앱»에 붙여야 할 때만 (선택) ─────────────────────────────
# 메타는 이용 사례끼리 호환되지 않으면 같은 앱에 못 붙인다. 광고 이용 사례가 기존
# 인스타·스레드 앱에서 회색으로 비활성화돼 있으면 **광고용 앱을 따로 만들어야 한다.**
# ⚠️ 그때 META_APP_SECRET 을 새 앱 값으로 덮으면 **인스타 웹훅 서명 검증이 조용히 깨진다**
#    (같은 변수를 쓴다 — 웹훅은 계속 200 을 주는데 이벤트가 전부 버려진다).
# 아래 두 변수를 채우면 광고만 새 앱을 쓰고 기존 채널은 건드리지 않는다.
# 같은 앱에 붙였다면 둘 다 비워 둔다.
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# 사이트 정본 URL — OAuth 콜백(redirect_uri) 계산에 사용. 예: https://finch.ai.kr
# 미설정이면 요청 헤더에서 유추(로컬/프리뷰). 프로덕션은 명시 권장.
NEXT_PUBLIC_SITE_URL=

# ── Vercel Cron (토큰 자동갱신·DM 재처리 — 서버 전용) ─────────────────────
# 임의의 긴 랜덤 문자열. Vercel이 크론 호출에 Bearer 헤더로 붙여준다.
# 미설정이면 크론 라우트가 401/거부로 동작하지 않는다(무단 트리거 방지).
CRON_SECRET=

# ── Toss Payments (결제, 테스트 모드) ──────────────────────────────────────
# 키 세트 2종 — 발급: 개발자센터(developers.tosspayments.com) > 내 개발정보 > API 키.
# 실 스펙: docs/REAL_API_SPEC.md 4절.
#
# 1) 결제위젯 연동 키 (단건 결제창): 클라이언트 test_gck_...(공개), 시크릿 test_gsk_...(서버 전용)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
#
# 2) API 개별 연동 키 (자동결제·빌링): 클라이언트 test_ck_...(공개), 시크릿 test_sk_...(서버 전용)
#    빌링(정기결제)은 반드시 이 세트 — 위젯 키로 호출하면 오류. 테스트 키로 개발·테스트 가능,
#    라이브 전환만 자동결제 별도 계약 필요.
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=
TOSS_BILLING_SECRET_KEY=

# ── 공용 풀 운영 경보 (서버 전용) ─────────────────────────────────────────
# 수집이 멈췄을 때(공급사 크레딧 소진·하루 예산 소진) 알림 메일을 받을 주소.
# 고객이 아니라 운영자에게 가는 메일이라 사용자 알림과 분리한다.
# 미설정이면 경보는 서버 로그에만 남는다(수집 동작 자체에는 영향 없음).
OWNER_EMAIL=

# ── 레퍼런스·경쟁사 광고 수집 (서버 전용) ─────────────────────────────────
# ScrapeCreators API 키. 공용 풀 크론(pool-plan/pool-work/pool-finalize)과
# 레퍼런스 수집이 전부 이 키로 돈다 — **없으면 수집이 통째로 죽는다**
# (lib/reference/meta-ads.ts, lib/reference/scrapecreators.ts).
# 한국 상업광고는 공식 Meta Ad Library API 가 EU/UK 만 반환해 이 경로를 쓴다.
SCRAPECREATORS_API_KEY=

# 임베딩(풀 유사도) — lib/pool/embedding.ts. 미설정이면 임베딩 단계만 건너뛴다.
UPSTAGE_API_KEY=

# ── 프로필 링크 잠금 쿠키 서명 (서버 전용) ────────────────────────────────
# 비밀번호 잠금 페이지의 해제 쿠키를 서명하는 키(lib/links/password.ts).
# ⚠️ 미설정이면 SUPABASE_SERVICE_ROLE_KEY 를 대신 쓴다 — 그러면 **롤 키를 교체하는 순간
# 모든 페이지의 잠금해제 쿠키가 무효**가 되어 방문자가 전부 다시 비밀번호를 넣어야 한다.
# 롤 키는 인트라넷 등 외부와 공유되므로 교체 가능성이 있다. 반드시 따로 설정할 것.
LINK_COOKIE_SECRET=

# ── 채널 연결 여닫이 (서버 전용) ──────────────────────────────────────────
# **기본값은 닫힘이다.** 플랫폼 승인이 끝나 실제로 연결되는 채널만 여기 적는다.
# 값: instagram, threads, tiktok, ads 중 열린 것만 쉼표로. 비어 있으면 넷 다 닫힘.
#
# 닫힌 채널은 고객 화면에서 「준비 중 · 곧 열릴 예정이에요」로 보이고 연결 버튼이 아예 사라지며,
# 주소를 직접 열어도 start 라우트가 막고, 대시보드 연동 안내 창에서도 빠진다.
# 자격증명이 다 있어도 플랫폼이 우리 앱을 일반 사용자에게 안 열어 준 기간에는 눌러 봐야 막히기 때문이다.
#
# ⚠️ OWNER_EMAIL 계정은 닫혀 있어도 연결할 수 있다 — 고객에게 열기 전에 직접 확인해야 하기 때문이다.
#    그래서 운영자 화면만 보면 멀쩡해 보인다. 설정 > SNS 계정 연결 위에 「고객에게는 아직 닫혀 있다」는
#    운영자 전용 안내가 뜬다 — 승인이 난 뒤 여기 이름 추가하는 걸 잊지 않게 하는 장치다.
CHANNELS_OPEN=

# ── 오류 수집 (Sentry) ────────────────────────────────────────────────────
# sentry.io > 프로젝트 finch > Settings > Client Keys (DSN). 공개 가능한 값이라 NEXT_PUBLIC_.
# 비어 있으면 SDK 가 꺼진 채로 동작한다(빌드·런타임 영향 없음). 있으면 서버 오류(라우트·액션·크론)와
# 서버 console.error 가 전부 이벤트로 올라간다 — 개인정보(IP·쿠키·헤더)는 보내지 않는다.
# 브라우저 오류는 **앱 화면에서만** 잡는다(components/monitoring/sentry-client.tsx, 지연 로드) —
# 방문자 프로필 페이지(/{slug})에는 SDK 를 싣지 않는다(첫 화면 무게).
NEXT_PUBLIC_SENTRY_DSN=
# (선택) 소스맵 업로드 — 없어도 오류는 잡히지만 스택이 압축된 이름으로 보인다.
# SENTRY_ORG / SENTRY_PROJECT 는 sentry.io 주소의 슬러그. 토큰은 Settings > Auth Tokens (org:read, project:releases).
# 빌드 시점(Vercel)에만 쓰인다. 셋 다 있을 때만 업로드하고, 하나라도 없으면 조용히 건너뛴다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── 방문 집계 버퍼 (Upstash Redis — 서버 전용) ────────────────────────────
# console.upstash.com > Redis > 데이터베이스 > REST API 의 .env 탭에 있는 두 줄.
# 비어 있으면 프로필 링크 방문·체류를 지금처럼 DB 에 바로 기록한다 — 기능 손실 없음, 방문당 DB 쿼리만 8~10회.
# 있으면 중복 판정·분당 천장을 Redis 에서 하고 방문 행은 모아 두었다가 /api/cron/flush-views 가 1분마다 묶어 넣는다.
# Vercel 마켓플레이스로 만들었으면 KV_REST_API_URL / KV_REST_API_TOKEN 이름도 그대로 읽는다.
# 무료 티어(월 50만 명령)의 실질 용량은 크론 공회전을 빼면 **월 6~8만 방문** 정도 — 넘으면 명령이 거부되고
# 코드는 60초 회로 차단 후 DB 직접 기록으로 되돌아간다(기능 손실 없음). 카드를 등록했다면 Upstash 콘솔에서
# 월 예산 상한(Max Monthly Budget)을 걸어 둘 것 — 종량제 $0.2/10만 명령이 폭주 트래픽에 그대로 청구된다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 메일 발송 (서버 전용) ─────────────────────────────────────────────────
# Resend API 키. 미설정이면 lib/email/resend.ts 가 **조용히 아무것도 안 한다** —
# 위 OWNER_EMAIL 을 넣어 두어도 운영 경보 메일이 한 통도 가지 않는다.
RESEND_API_KEY=
